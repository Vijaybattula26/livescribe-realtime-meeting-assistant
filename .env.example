# Gemini API Key (Required for server-side token generation and extraction)
GEMINI_API_KEY=your_gemini_api_key_here

# Models (Configurable without changing code)
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_EXTRACT_MODEL=gemini-3.1-flash-lite

# Server Configuration
PORT=3001
NODE_ENV=development

# CORS settings (frontend origin)
ALLOWED_ORIGIN=http://localhost:5173

# Optional Security and Session Hardening (Relay controls)
APP_PASSWORD=
MAX_CONCURRENT_SESSIONS=20
MAX_SESSION_DURATION_MS=1800000
TRUST_PROXY_HOPS=1
DAILY_LIVE_SESSION_MINUTES_LIMIT=120
DAILY_EXTRACTION_CALLS_LIMIT=200
DEBUG=false


